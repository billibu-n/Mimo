{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mimo",
  "version": "1.2.0-beta.1",
  "identifier": "cl.mimo.escritorio",
  "build": {
    "beforeBuildCommand": "python3 preparar-frontend.py",
    "frontendDist": "../app"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mimo",
        "width": 1280,
        "height": 900,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/48x48.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Mimo — organizador global con bloques, offline y sync WebDAV cifrada.",
    "longDescription": "Mimo es un organizador global con bloques instalables: calendario, tareas, notas, malla, calificaciones, estudio y tiempo. Funciona sin conexion, guarda los datos en el equipo y puede sincronizarlos cifrados por WebDAV/Nextcloud.",
    "publisher": "Billibu",
    "copyright": "Copyright © 2026 billibu-n",
    "license": "MIT",
    "homepage": "https://github.com/billibu-n/mimo-nuevo",
    "linux": {
      "rpm": {
        "desktopTemplate": "Mimo.desktop",
        "postInstallScript": "scripts/postinstall.sh",
        "files": {
          "/usr/share/metainfo/cl.mimo.escritorio.metainfo.xml": "metainfo/cl.mimo.escritorio.metainfo.xml"
        },
        "depends": [
          "glibc >= 2.39",
          "openssl-libs"
        ]
      },
      "deb": {
        "desktopTemplate": "Mimo.desktop",
        "postInstallScript": "scripts/postinstall.sh",
        "files": {
          "/usr/share/metainfo/cl.mimo.escritorio.metainfo.xml": "metainfo/cl.mimo.escritorio.metainfo.xml"
        },
        "depends": [
          "libc6 (>= 2.39)",
          "libssl3"
        ]
      }
    }
  }
}
